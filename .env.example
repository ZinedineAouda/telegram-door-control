# ==============================================================================
# Telegram Door Control Configuration
# ==============================================================================

# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_example

# Comma-separated list of authorized Telegram numeric user IDs.
# Never use usernames here. Obtain your ID by sending /start to @userinfobot.
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# Secret shared key between ESP8266 and the server.
# Set a long random string (e.g. openssl rand -hex 24).
# This key is hashed with bcrypt in the local SQLite database.
DEVICE_KEY=d9c72e91a03f4826b1582e3c098a123f456789abcdef0123

# Optional display name for the registered device
DEVICE_NAME=Door-ESP8266-Main

# Local SQLite database file path (persisted on disk)
DB_PATH=./data/door.db

# Embedded API server port (the ESP8266 connects here)
API_PORT=8443

# Relay contact closure pulse duration in milliseconds (typically 300 to 500 ms)
PULSE_DURATION_MS=400

# Server environment: 'production' for HTTPS, or 'development' for local HTTP
NODE_ENV=development

# TLS certificate paths (Required when NODE_ENV=production)
# Obtain these using Let's Encrypt / Certbot:
#   certbot certonly --standalone -d your-door-server.example.com
TLS_CERT_PATH=/etc/letsencrypt/live/your-door-server.example.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/your-door-server.example.com/privkey.pem
